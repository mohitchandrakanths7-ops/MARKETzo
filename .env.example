# Server Environment Variables
PORT=5000
NODE_ENV=development
JWT_SECRET=marketzo-secure-jwt-secret-key-2026

# PostgreSQL Database Configuration (Auto-provided on Render via DATABASE_URL)
DATABASE_URL=postgres://marketzo_user:password@localhost:5432/marketzo_db

# Alternative Individual Database Variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=marketzo_db
